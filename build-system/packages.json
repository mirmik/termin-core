{
  "schema": 1,
  "description": "Termin Core SDK Python package manifest.",
  "packages": [
    {
      "path": "termin-build-tools",
      "distribution": "termin-build-tools"
    },
    {
      "path": "termin-nanobind-sdk",
      "distribution": "termin-nanobind"
    },
    {
      "path": "termin-base",
      "distribution": "tcbase",
      "native_extensions": [
        {
          "extension": "tcbase._tcbase_native",
          "target": "_tcbase_native"
        },
        {
          "extension": "tcbase._geom_native",
          "target": "_geom_native"
        }
      ]
    },
    {
      "path": "termin-dispatch",
      "distribution": "termin-dispatch",
      "native_extensions": [
        {
          "extension": "termin.dispatch._dispatch_native",
          "target": "_dispatch_native"
        }
      ]
    },
    {
      "path": "termin-inspect",
      "distribution": "termin-inspect",
      "native_extensions": [
        {
          "extension": "termin.inspect._inspect_native",
          "target": "_inspect_native"
        }
      ]
    },
    {
      "path": "termin-mcp",
      "distribution": "termin-mcp"
    }
  ]
}
